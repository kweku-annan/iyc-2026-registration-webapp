# Frontend environment variables
# Copy to .env.local for local development (never commit .env.local)

# URL of the FastAPI backend (no trailing slash)
# Dev:        http://localhost:8000
# Production: https://api.yourdomain.com
VITE_API_URL=http://localhost:8000

# Public site URL — used to build QR code check-in links (/c/<code>)
# Dev:        http://localhost:5173
# Production: https://www.yourdomain.com
VITE_SITE_URL=http://localhost:5173

# Cloudflare Turnstile Site Key (Anti-Bot / Abuse Protection)
# Testing sitekey (always passes): 1x00000000000000000000AA
# Leave empty to bypass in local development.
VITE_TURNSTILE_SITE_KEY=


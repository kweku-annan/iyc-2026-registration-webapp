# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/iyc2026

# ── Seed (used by: python -m app.seed) ───────────────────────────────────────
SEED_ORGANIZER_EMAIL=admin@iyc2026.com
SEED_ORGANIZER_PASSWORD=change-me-before-seeding  # minimum 8 characters

# ── Security ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must be at least 32 characters long.
SECRET_KEY=change-me-generate-a-real-secret

# ── CORS / Cookies ────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_DOMAIN=localhost

# ── Environment ───────────────────────────────────────────────────────────────
# Set to "production" to disable Swagger UI, ReDoc, and OpenAPI schema endpoint.
ENVIRONMENT=development

# ── Paystack ─────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxx

# ── SMS (mNotify) ─────────────────────────────────────────────────────────────
# SMS_PROVIDER=console   → prints OTPs/SMS to log (dev mode)
# SMS_PROVIDER=mnotify   → real SMS (staging/production)
SMS_PROVIDER=console
MNOTIFY_API_KEY=your-mnotify-api-key
MNOTIFY_ENDPOINT=https://api.mnotify.com/api/sms/quick
SMS_SENDER_ID=IYC2026

# ── OTP ───────────────────────────────────────────────────────────────────────
OTP_ENABLED=true

# ── Cloudflare Turnstile (Anti-Bot / Abuse Protection) ──────────────────────
# Free at dash.cloudflare.com -> Turnstile
# Set to false or leave empty for local development bypass.
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA  # Cloudflare dummy always-pass secret


# ── Locale ────────────────────────────────────────────────────────────────────
DEFAULT_PHONE_REGION=GH
EVENT_TIMEZONE=Africa/Accra
